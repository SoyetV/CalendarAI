// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatarUrl String?
  provider  String   @default("google")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uploads ScheduleUpload[]
}

model ScheduleUpload {
  id         String   @id @default(cuid())
  userId     String
  imageUrl   String
  imageName  String?
  status     String   @default("pending") // pending | parsed | synced | error
  untilDate  String?  // ISO date string, the recurrence end date
  timezone   String   @default("Asia/Shanghai")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries ScheduleEntry[]
  logs   SyncLog[]

  @@index([userId])
}

model ScheduleEntry {
  id              String   @id @default(cuid())
  uploadId        String
  userId          String
  courseCode      String
  courseName      String?
  room            String?
  dayOfWeek       String   // MO | TU | WE | TH | FR | SA | SU
  startTime       String   // HH:MM (24h)
  endTime         String   // HH:MM (24h)
  color           String?  // optional color label from the source image
  notes           String?
  calendarEventId String?  // ID of the created calendar event (ics UID), null until synced
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  upload ScheduleUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([uploadId])
  @@index([userId])
}

model SyncLog {
  id           String   @id @default(cuid())
  uploadId     String
  userId       String
  syncedAt     DateTime @default(now())
  untilDate    String?
  result       String   // success | error
  errorMessage String?
  entriesCount Int      @default(0)

  upload ScheduleUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([uploadId])
}
